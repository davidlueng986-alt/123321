// FinSight AI - Production-Grade Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  VIEWER
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum ReportType {
  PROFIT_LOSS
  CASH_FLOW
  EXPENSE_SUMMARY
  REVENUE_TRENDS
  BALANCE_SHEET
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SHARE
}

enum NotificationType {
  INVOICE_OVERDUE
  CASH_FLOW_WARNING
  UNUSUAL_EXPENSE
  PAYMENT_RECEIVED
  REPORT_READY
  SYSTEM_ALERT
  AI_INSIGHT
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum AnomalyType {
  UNUSUAL_AMOUNT
  DUPLICATE_TRANSACTION
  UNUSUAL_FREQUENCY
  CATEGORY_MISMATCH
  LARGE_TRANSFER
}

// ─────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────

model Organization {
  id              String   @id @default(cuid())
  clerkOrgId      String   @unique
  name            String
  slug            String   @unique
  description     String?
  industry        String?
  currency        String   @default("USD")
  fiscalYearStart Int      @default(1) // Month (1-12)
  timezone        String   @default("UTC")
  logoUrl         String?
  website         String?
  taxId           String?
  address         Json?
  settings        Json?    @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  members      OrganizationMember[]
  transactions Transaction[]
  invoices     Invoice[]
  expenses     Expense[]
  categories   Category[]
  reports      Report[]
  notifications Notification[]
  auditLogs    AuditLog[]
  aiChats      AIChat[]
  insights     Insight[]
  cashFlowForecasts CashFlowForecast[]
  bankStatements BankStatement[]
  clients      Client[]
  vendors      Vendor[]

  @@index([clerkOrgId])
  @@index([slug])
  @@map("organizations")
}

// ─────────────────────────────────────────────
// USER & MEMBERSHIP
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  firstName    String
  lastName     String
  imageUrl     String?
  phone        String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  loginCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  memberships  OrganizationMember[]
  auditLogs    AuditLog[]
  aiChats      AIChat[]
  expenses     Expense[]         @relation("ExpenseCreator")
  approvedExpenses Expense[]     @relation("ExpenseApprover")
  invoices     Invoice[]
  notifications Notification[]

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(EMPLOYEE)
  permissions    Json     @default("{}")
  invitedAt      DateTime?
  joinedAt       DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ─────────────────────────────────────────────
// CLIENTS & VENDORS
// ─────────────────────────────────────────────

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  company        String?
  address        Json?
  taxId          String?
  notes          String?
  isActive       Boolean  @default(true)
  totalRevenue   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId])
  @@index([email])
  @@map("clients")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  company        String?
  address        Json?
  taxId          String?
  notes          String?
  isActive       Boolean  @default(true)
  totalSpent     Decimal  @default(0) @db.Decimal(15, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@index([organizationId])
  @@map("vendors")
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           CategoryType
  color          String?
  icon           String?
  description    String?
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

// ─────────────────────────────────────────────
// TRANSACTIONS
// ─────────────────────────────────────────────

model Transaction {
  id             String          @id @default(cuid())
  organizationId String
  categoryId     String?
  type           TransactionType
  amount         Decimal         @db.Decimal(15, 2)
  currency       String          @default("USD")
  exchangeRate   Decimal?        @db.Decimal(10, 6)
  description    String
  reference      String?
  date           DateTime
  dueDate        DateTime?
  metadata       Json?           @default("{}")
  tags           String[]
  isReconciled   Boolean         @default(false)
  isAnomaly      Boolean         @default(false)
  anomalyDetails Json?
  invoiceId      String?
  expenseId      String?
  bankStatementId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  expense       Expense?       @relation(fields: [expenseId], references: [id])
  bankStatement BankStatement? @relation(fields: [bankStatementId], references: [id])

  @@index([organizationId])
  @@index([date])
  @@index([type])
  @@index([categoryId])
  @@index([organizationId, date])
  @@map("transactions")
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String?
  createdById    String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime
  dueDate        DateTime
  paidAt         DateTime?
  subtotal       Decimal       @db.Decimal(15, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @db.Decimal(15, 2)
  total          Decimal       @db.Decimal(15, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(15, 2)
  amountDue      Decimal       @db.Decimal(15, 2)
  currency       String        @default("USD")
  notes          String?
  terms          String?
  metadata       Json?         @default("{}")
  sentAt         DateTime?
  viewedAt       DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  transactions  Transaction[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  sortOrder   Int     @default(0)

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Decimal  @db.Decimal(15, 2)
  currency      String   @default("USD")
  method        String   // card, bank_transfer, cash, etc.
  reference     String?
  notes         String?
  paidAt        DateTime
  createdAt     DateTime @default(now())

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  vendorId       String?
  createdById    String
  approvedById   String?
  status         ExpenseStatus @default(PENDING)
  amount         Decimal       @db.Decimal(15, 2)
  currency       String        @default("USD")
  description    String
  date           DateTime
  receiptUrl     String?
  receiptKey     String?       // S3 key
  notes          String?
  metadata       Json?         @default("{}")
  tags           String[]
  isReimbursable Boolean       @default(false)
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  createdBy    User         @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy   User?        @relation("ExpenseApprover", fields: [approvedById], references: [id])
  transactions Transaction[]

  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@index([categoryId])
  @@map("expenses")
}

// ─────────────────────────────────────────────
// BANK STATEMENTS
// ─────────────────────────────────────────────

model BankStatement {
  id             String   @id @default(cuid())
  organizationId String
  fileName       String
  fileKey        String   // S3 key
  fileType       String   // pdf, csv, xlsx
  fileSize       Int
  bankName       String?
  accountNumber  String?
  accountType    String?
  statementFrom  DateTime?
  statementTo    DateTime?
  totalCredits   Decimal? @db.Decimal(15, 2)
  totalDebits    Decimal? @db.Decimal(15, 2)
  openingBalance Decimal? @db.Decimal(15, 2)
  closingBalance Decimal? @db.Decimal(15, 2)
  transactionCount Int?
  processedAt    DateTime?
  isProcessed    Boolean  @default(false)
  processingError String?
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@map("bank_statements")
}

// ─────────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────────

model Report {
  id             String       @id @default(cuid())
  organizationId String
  type           ReportType
  name           String
  description    String?
  parameters     Json         // Date range, filters etc.
  data           Json         // Pre-computed report data
  fileUrl        String?
  fileKey        String?
  format         ReportFormat?
  generatedAt    DateTime     @default(now())
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@map("reports")
}

// ─────────────────────────────────────────────
// AI FEATURES
// ─────────────────────────────────────────────

model AIChat {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  model          String   @default("gpt-4o")
  metadata       Json?    @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIChatMessage[]

  @@index([organizationId])
  @@index([userId])
  @@map("ai_chats")
}

model AIChatMessage {
  id         String   @id @default(cuid())
  chatId     String
  role       String   // user, assistant, system
  content    String   @db.Text
  metadata   Json?    @default("{}")
  tokens     Int?
  cost       Decimal? @db.Decimal(10, 6)
  latencyMs  Int?
  citations  Json?    // Referenced financial records
  createdAt  DateTime @default(now())

  // Relations
  chat AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("ai_chat_messages")
}

model Insight {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  content        String   @db.Text
  type           String   // expense_spike, cash_warning, revenue_concentration, etc.
  severity       String   @default("info") // info, warning, critical
  data           Json?    // Supporting data
  isRead         Boolean  @default(false)
  isDismissed    Boolean  @default(false)
  validUntil     DateTime?
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@map("insights")
}

// ─────────────────────────────────────────────
// CASH FLOW FORECASTING
// ─────────────────────────────────────────────

model CashFlowForecast {
  id             String   @id @default(cuid())
  organizationId String
  forecastDate   DateTime
  period         String   // monthly, weekly, daily
  expectedIncome Decimal  @db.Decimal(15, 2)
  expectedExpenses Decimal @db.Decimal(15, 2)
  expectedBalance Decimal @db.Decimal(15, 2)
  confidence     Decimal? @db.Decimal(5, 2) // 0-100%
  methodology    String?
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([forecastDate])
  @@map("cash_flow_forecasts")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  message        String
  data           Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  action         AuditAction
  resource       String      // table/resource name
  resourceId     String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json?       @default("{}")
  createdAt      DateTime    @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// ANOMALIES
// ─────────────────────────────────────────────

model Anomaly {
  id             String      @id @default(cuid())
  organizationId String
  transactionId  String?
  type           AnomalyType
  description    String
  severity       String      @default("medium")
  isResolved     Boolean     @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  metadata       Json?       @default("{}")
  createdAt      DateTime    @default(now())

  @@index([organizationId])
  @@index([isResolved])
  @@map("anomalies")
}
